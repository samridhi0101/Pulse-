  <script src="shared.js"></script>
  <script>
    function showTab(t, el) {
      document.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
      document.querySelectorAll('.pane').forEach(x => x.classList.remove('active'));
      el.classList.add('active');
      document.getElementById('pane-' + t).classList.add('active');
    }
    function toggleSidebar() { document.body.classList.toggle('sidebar-collapsed'); }

    function openStageFlyout(stage, count, value) {
      const dealsByStage = {
        'Discovery':     [['MedTech Reporting Module','MedTech Corp','Vikram S.','$0.05M','12d'],['HealthFirst Mobile','HealthFirst','Anita M.','$0.10M','8d'],['BioGen LIMS','BioGen','Kiran R.','$0.15M','22d'],['NeuroLab Imaging','NeuroLab','Arjun N.','$0.08M','5d']],
        'Qualification': [['MedTech DevOps','MedTech Corp','Vikram S.','$0.04M','18d'],['PharmCare Analytics','PharmCare','Suresh K.','$0.07M','35d'],['CardioTech Dashboard','CardioTech','Divya L.','$0.12M','22d']],
        'Proposal':      [['HealthFirst DR','HealthFirst','Anita M.','$0.10M','28d'],['BioGen Phase 2','BioGen','Kiran R.','$0.17M','42d'],['MedTech Module Demo','MedTech','Vikram S.','$0.25M','15d']],
        'Negotiation':   [['PediaCare Platform','PediaCare','Rohan T.','$0.20M','38d'],['OrthoFix Mobile','OrthoFix','Kiran R.','$0.08M','25d']],
        'Verbal Yes':    [['WellnessOne Renewal','WellnessOne','Meera P.','$0.10M','12d'],['MedTech DevOps','MedTech','Vikram S.','$0.04M','22d']]
      };
      const rows = (dealsByStage[stage] || []).map(d => `<tr><td>${d[0]}</td><td>${d[1]}</td><td>${d[2]}</td><td>${d[3]}</td><td>${d[4]}</td></tr>`).join('');
      openFlyout({
        title: 'Pipeline Stage: ' + stage,
        sub: `${count} deals · ${value} total value`,
        body: `
          <div class="g-stat-row">
            <div class="g-stat"><div class="g-stat-label">Deals</div><div class="g-stat-val">${count}</div></div>
            <div class="g-stat"><div class="g-stat-label">Total value</div><div class="g-stat-val">${value}</div></div>
            <div class="g-stat"><div class="g-stat-label">Avg age</div><div class="g-stat-val">${stage === 'Discovery' ? '12d' : (stage === 'Qualification' ? '24d' : (stage === 'Proposal' ? '28d' : '30d'))}</div></div>
          </div>
          <div class="g-section-title">Top deals at this stage</div>
          <table class="g-tbl"><thead><tr><th>Deal</th><th>Account</th><th>Owner</th><th>Value</th><th>Age</th></tr></thead><tbody>${rows}</tbody></table>`
      });
    }
    const OPP_DETAIL = {
      'BioGen Phase 2': { current:'Proposal', value:'$0.17M', daysSinceAction:42, closeProb:38, owner:'Kiran R.', alert:{kind:'red',html:'<strong>Stalled:</strong> 42 days without action · CIO turnover blocking decision · risk of slippage to Q3'}, stages:[
        {name:'Discovery',  date:'Mar 12 · Done',  status:'done',   salient:'Initial scope confirmed · 3 stakeholders'},
        {name:'Qualification', date:'Mar 28 · Done', status:'done', salient:'BANT confirmed · CIO sponsor'},
        {name:'Proposal',  date:'Apr 8 · Stuck',   status:'late',   salient:'$0.17M proposal sent · awaiting response', noteCls:'late-note', note:'CIO replaced Apr 12 · new sponsor not aligned'},
        {name:'Negotiation', date:'TBD',           status:'todo',   salient:'Pending after CIO alignment'},
        {name:'Verbal Yes', date:'TBD',           status:'todo',   salient:''},
        {name:'Closed',    date:'TBD',           status:'todo',   salient:''}
      ], activity:['Apr 8 — Proposal sent ($0.17M scope)','Mar 28 — BANT qualified · CIO confirmed','Mar 22 — Architecture review','Mar 12 — Discovery call (3 stakeholders)']},
      'PediaCare Platform': { current:'Negotiation', value:'$0.20M', daysSinceAction:38, closeProb:55, owner:'Rohan T.', alert:{kind:'red',html:'<strong>At Risk:</strong> 38d without action · pricing negotiation stalled at procurement step'}, stages:[
        {name:'Discovery',date:'Feb 18 · Done',status:'done',salient:'5 stakeholders mapped'},
        {name:'Qualification',date:'Mar 5 · Done',status:'done',salient:'Budget approved'},
        {name:'Proposal',date:'Mar 22 · Done',status:'done',salient:'Multi-tier pricing presented'},
        {name:'Negotiation',date:'Apr 5 · Active',status:'active',salient:'Awaiting volume discount approval', note:'Procurement layer added Apr 5'},
        {name:'Verbal Yes',date:'TBD',status:'todo',salient:''},
        {name:'Closed',date:'TBD',status:'todo',salient:''}
      ], activity:['Apr 5 — Procurement entered process','Mar 28 — Negotiation kickoff','Mar 22 — Proposal delivered','Mar 5 — Qualified','Feb 18 — Discovery']},
      'OrthoFix Mobile': { current:'Negotiation', value:'$0.08M', daysSinceAction:25, closeProb:62, owner:'Kiran R.', alert:{kind:'amber',html:'<strong>Watch:</strong> Pricing approval pending from director · 25d w/o action'}, stages:[
        {name:'Discovery',date:'Done',status:'done',salient:''},{name:'Qualification',date:'Done',status:'done',salient:''},{name:'Proposal',date:'Done',status:'done',salient:''},{name:'Negotiation',date:'Active',status:'active',salient:'Director approval pending'},{name:'Verbal Yes',date:'TBD',status:'todo',salient:''},{name:'Closed',date:'TBD',status:'todo',salient:''}
      ], activity:['Apr 12 — Pricing model sent','Apr 4 — Negotiation start','Mar 22 — Proposal','Mar 5 — Qualified']},
      'CardioTech Dashboard': { current:'Verbal Yes', value:'$0.12M', daysSinceAction:22, closeProb:78, owner:'Divya L.', alert:{kind:'amber',html:'<strong>Watch:</strong> Verbal yes received but contract still pending · 22d'}, stages:[
        {name:'Discovery',date:'Done',status:'done',salient:''},{name:'Qualification',date:'Done',status:'done',salient:''},{name:'Proposal',date:'Done',status:'done',salient:''},{name:'Negotiation',date:'Done',status:'done',salient:'Final pricing locked'},{name:'Verbal Yes',date:'Apr 13',status:'active',salient:'Contract drafting in progress'},{name:'Closed',date:'TBD',status:'todo',salient:''}
      ], activity:['Apr 13 — Verbal yes received','Apr 8 — Final negotiation','Apr 1 — Proposal','Mar 18 — Qualified']},
      'HealthFirst DR': { current:'Negotiation', value:'$0.10M', daysSinceAction:18, closeProb:72, owner:'Anita M.', alert:{kind:'amber',html:'<strong>Watch:</strong> InfoSec review delaying SOW signature'}, stages:[
        {name:'Discovery',date:'Done',status:'done',salient:''},{name:'Qualification',date:'Done',status:'done',salient:''},{name:'Proposal',date:'Done',status:'done',salient:''},{name:'Negotiation',date:'Active',status:'active',salient:'InfoSec review'},{name:'Verbal Yes',date:'TBD',status:'todo',salient:''},{name:'Closed',date:'TBD',status:'todo',salient:''}
      ], activity:['Apr 17 — SOW with InfoSec','Apr 12 — Pricing agreed','Apr 1 — Proposal','Mar 18 — Qualified']},
      'MedTech DevOps add-on': { current:'Verbal Yes', value:'$0.04M', daysSinceAction:2, closeProb:92, owner:'Vikram S.', alert:{kind:'green',html:'<strong>On Track:</strong> Verbal yes secured · contract signature May 9'}, stages:[
        {name:'Discovery',date:'Done',status:'done',salient:''},{name:'Qualification',date:'Done',status:'done',salient:''},{name:'Proposal',date:'Done',status:'done',salient:''},{name:'Negotiation',date:'Done',status:'done',salient:''},{name:'Verbal Yes',date:'May 3',status:'active',salient:'Signature scheduled May 9'},{name:'Closed',date:'May 9',status:'todo',salient:'Contract signing'}
      ], activity:['May 3 — Verbal yes','Apr 28 — Final terms','Apr 14 — Proposal','Apr 1 — Discovery']},
      'WellnessOne Renewal': { current:'Verbal Yes', value:'$0.10M', daysSinceAction:3, closeProb:95, owner:'Meera P.', alert:{kind:'green',html:'<strong>On Track:</strong> Renewal verbal yes · expansion verbal received'}, stages:[
        {name:'Discovery',date:'Done',status:'done',salient:'Renewal triggered'},{name:'Qualification',date:'Done',status:'done',salient:''},{name:'Proposal',date:'Done',status:'done',salient:''},{name:'Negotiation',date:'Done',status:'done',salient:''},{name:'Verbal Yes',date:'May 2',status:'active',salient:'Renewal + expansion'},{name:'Closed',date:'May 12',status:'todo',salient:''}
      ], activity:['May 2 — Verbal yes','Apr 25 — Renewal terms','Apr 10 — Proposal','Mar 28 — Discovery']}
    };
    function openOppDetail(name, owner) {
      const d = OPP_DETAIL[name] || { current:'Discovery', value:'TBD', daysSinceAction:0, closeProb:50, owner:owner, alert:{kind:'amber',html:'<strong>Detail:</strong> Standard opportunity tracking.'}, stages:[
        {name:'Discovery',date:'',status:'todo',salient:''},{name:'Qualification',date:'',status:'todo',salient:''},{name:'Proposal',date:'',status:'todo',salient:''},{name:'Negotiation',date:'',status:'todo',salient:''},{name:'Verbal Yes',date:'',status:'todo',salient:''},{name:'Closed',date:'',status:'todo',salient:''}
      ], activity:[]};

      const stagesHtml = d.stages.map(s => `
        <div class="sdlc-step">
          <div class="sdlc-spine">
            <div class="sdlc-dot ${s.status}"></div>
            <div class="sdlc-marker-line"></div>
            <div class="sdlc-line"></div>
          </div>
          <div class="sdlc-content">
            <div class="sdlc-row">
              <div class="sdlc-text">
                <div class="sdlc-stage-name">${s.name}</div>
                <div class="sdlc-dates">${s.date}</div>
              </div>
              ${s.salient ? `<div class="sdlc-salient">${s.salient}</div>` : ''}
            </div>
            ${s.note ? `<div class="sdlc-note ${s.noteCls || ''}">${s.note}</div>` : ''}
          </div>
        </div>`).join('');

      openFlyoutPinned({
        title: name,
        sub: `Owner: ${d.owner} · Value: ${d.value} · ${d.daysSinceAction}d w/o action`,
        pinned: `<div class="fly-alert ${d.alert.kind}">${d.alert.html}</div>
          <div class="g-stat-row">
            <div class="g-stat"><div class="g-stat-label">Current Stage</div><div class="g-stat-val">${d.current}</div></div>
            <div class="g-stat"><div class="g-stat-label">Days w/o Action</div><div class="g-stat-val ${d.daysSinceAction>21?'red':(d.daysSinceAction>10?'amber':'green')}">${d.daysSinceAction}d</div></div>
            <div class="g-stat"><div class="g-stat-label">Close Prob</div><div class="g-stat-val ${d.closeProb>=70?'green':(d.closeProb>=50?'amber':'red')}">${d.closeProb}%</div></div>
          </div>`,
        body: `
          <div class="g-section-title">Sales Pipeline Stages</div>
          <div class="sdlc-track">${stagesHtml}</div>
          <div class="g-section-title">Activity Timeline</div>
          ${d.activity.length ? d.activity.map(a => `<div style="padding:6px 8px;background:var(--bg);border-left:3px solid var(--blue);border-radius:4px;margin-bottom:5px;font-size:11px;color:var(--text);">${a}</div>`).join('') : '<p style="color:var(--text-muted);font-size:12px;">No activity logged.</p>'}`,
        footer: `<button class="btn primary">Log activity</button> <button class="btn ghost" onclick="closeFlyout()">Close</button>`
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      if (window.installActionsSection) {
        window.installActionsSection([
          {av:'VS',bg:'#FF9933',text:'Close MedTech Phase 2 demo follow-up',owner:'Vikram S.',planned:'2026-05-09',status:'wip'},
          {av:'SK',bg:'#DC2626',text:'Send technical proposal to MedTech',owner:'Suresh K.',planned:'2026-04-15',status:'todo'},
          {av:'KR',bg:'#F59E0B',text:'BioGen stakeholder alignment meeting',owner:'Kiran R.',planned:'2026-05-12',status:'wip'}
        ]);
      }
    });
  </script>
</body>
</html>
