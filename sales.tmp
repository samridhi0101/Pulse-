<!DOCTYPE html>
<html lang="en" data-theme="blue">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sales — Pulse · Nalashaa</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800&family=Fredoka:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="shared.css">
  <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
  <style>
    .tabs { display: flex; gap: 4px; border-bottom: 2px solid var(--border); margin-bottom: 18px; }
    .tab { padding: 10px 14px; cursor: pointer; font-size: 12px; font-weight: 600; color: var(--text-muted); border-bottom: 3px solid transparent; margin-bottom: -2px; }
    .tab.active { color: var(--navy); border-bottom-color: var(--orange); }
    [data-mode="dark"] .tab.active { color: #fff; }
    .pane { display: none; } .pane.active { display: block; }
    .kgrid { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; margin-bottom: 16px; }
    .kc { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 14px; border-left: 4px solid transparent; transition: all 0.15s; }
    .kc.green { border-left-color: var(--green); } .kc.amber { border-left-color: var(--amber); } .kc.red { border-left-color: var(--red); }
    .klbl { font-size: 10px; text-transform: uppercase; letter-spacing: 0.4px; color: var(--text-muted); font-weight: 700; margin-bottom: 6px; }
    .kval { font-size: 22px; font-weight: 800; color: var(--navy); }
    [data-mode="dark"] .kval { color: #fff; }
    .ksub { font-size: 11px; color: var(--text-muted); margin-top: 4px; }
    .stitle { font-size: 13px; font-weight: 700; color: var(--navy); margin: 14px 0 10px; padding-bottom: 6px; border-bottom: 2px solid var(--border); }
    [data-mode="dark"] .stitle { color: #fff; }
    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .card-box { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 14px; }
    .funnel-bar { background: var(--border); height: 28px; border-radius: 6px; overflow: hidden; cursor: pointer; }
    .funnel-fill { height: 100%; display: flex; align-items: center; padding-left: 10px; color: #fff; font-size: 11px; font-weight: 700; }
    .funnel-fill.s1 { background: linear-gradient(90deg, #FF9933 0%, #FFB976 100%); }
    .funnel-fill.s2 { background: linear-gradient(90deg, #F47C28 0%, #FFA868 100%); }
    .funnel-fill.s3 { background: linear-gradient(90deg, #E66B1F 0%, #F89954 100%); }
    .funnel-fill.s4 { background: linear-gradient(90deg, #C95819 0%, #E48944 100%); }
    .funnel-fill.s5 { background: linear-gradient(90deg, #A6450F 0%, #C97132 100%); }
    .data-fresh { font-size: 10px; color: var(--text-muted); margin-bottom: 10px; }
    .tbl { width: 100%; font-size: 12px; border-collapse: collapse; }
    .tbl th { padding: 8px 10px; background: var(--navy); color: #fff !important; font-size: 10px; text-transform: uppercase; letter-spacing: 0.4px; }
    .tbl td { padding: 8px 10px; border-bottom: 1px solid var(--border); cursor: pointer; }
    .tbl tr:hover td { background: var(--bg); }
    .badge { display: inline-block; padding: 2px 7px; border-radius: 4px; font-size: 10px; font-weight: 700; }
    .badge.green { background: #D1FAE5; color: #065F46; }
    .badge.amber { background: #FEF3C7; color: #92400E; }
    .badge.red { background: #FEE2E2; color: #991B1B; }
    .badge.grey { background: #F1F5F9; color: #475569; }
    .badge.future { background: #E0E7FF; color: #3730A3; }
  </style>
</head>
<body>
  <div class="top-nav">
    <div style="display:flex;align-items:center;gap:0;">
